# Allow only the runtime source, dependency lock and required notices into the build.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!LICENSE
!THIRD_PARTY_NOTICES.md
!src/
!src/*.js
!public/
!public/index.html
!public/*.js
!public/styles.css
!migrations/
!migrations/*.sql
!scripts/
!scripts/*.js
!config/
!config/collection-plan.example.json
!config/store-directory-plan.example.json
