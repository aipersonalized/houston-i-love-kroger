# Copy to .env and enter values privately. Never commit .env or paste it in chat.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ENVIRONMENT=production

# Local use: leave HOST as 127.0.0.1. See docs/SELF_HOSTING.md before hosting.
HOST=127.0.0.1
PORT=4173
APP_BASE_PATH=/apps/houston-i-love-kroger/
# Optional exact public origin, e.g. https://your-domain.example (no path).
PUBLIC_ORIGIN=

# Optional history database file. Blank uses .runtime/history.sqlite in this project.
# Keep this database private and outside public website folders.
HISTORY_DB_PATH=
