# Copy to .env and enter values privately. Never commit .env or paste it in chat.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ENVIRONMENT=production

# Local use: leave HOST as 127.0.0.1. See docs/SELF_HOSTING.md before hosting.
HOST=127.0.0.1
PORT=4173
APP_BASE_PATH=/apps/houston-i-love-kroger/
# Optional exact public origin, e.g. https://your-domain.example (no path).
PUBLIC_ORIGIN=

# Optional history database file. Blank uses .runtime/history.sqlite in this project.
# Keep this database private and outside public website folders.
HISTORY_DB_PATH=

# Optional separate promotion database service. Configure both URL and token.
# Blank keeps the existing single-process local history mode.
PROMOTION_SERVICE_URL=
# Generate a private random token (at least 32 characters); never publish it.
PROMOTION_SERVICE_TOKEN=
PROMOTION_SERVICE_HOST=127.0.0.1
PROMOTION_SERVICE_PORT=4174
PROMOTION_MAX_AGE_SECONDS=86400

# Optional shopper-authorized Cart. Leave disabled until the registration has
# actual Cart access and the exact HTTPS callback is registered. Never guess grants.
KROGER_CART_ENABLED=false
KROGER_CART_GRANTED=false
KROGER_CART_REDIRECT_URI=
